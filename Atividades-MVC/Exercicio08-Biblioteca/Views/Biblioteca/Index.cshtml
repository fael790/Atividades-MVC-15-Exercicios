@model IEnumerable<BibliotecaMVC.Models.Livro>
<h1>Biblioteca</h1><table><tr><th>Título</th><th>Autor</th><th>Ano</th><th>Situação</th></tr>
@foreach(var l in Model) { <tr><td>@l.Titulo</td><td>@l.Autor</td><td>@l.Ano</td><td>@(l.Disponivel ? "Disponível para empréstimo" : "Emprestado")</td></tr> }</table>
