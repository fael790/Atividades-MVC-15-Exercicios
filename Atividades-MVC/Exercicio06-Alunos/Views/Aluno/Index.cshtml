@model IEnumerable<CadastroAlunosMVC.Models.Aluno>
<h1>Cadastro de Alunos</h1>
<table><tr><th>ID</th><th>Nome</th><th>Idade</th><th>Curso</th><th></th></tr>
@foreach (var aluno in Model) {
<tr><td>@aluno.Id</td><td>@aluno.Nome</td><td>@aluno.Idade</td><td>@aluno.Curso</td><td><a href="/Aluno/Detalhes/@aluno.Id">Detalhes</a></td></tr>
}</table>
